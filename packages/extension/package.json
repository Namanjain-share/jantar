{
  "name": "@jantar/extension",
  "version": "0.5.3",
  "private": true,
  "license": "FSL-1.1-MIT",
  "description": "The Jantar Chrome extension: keeps a Google Meet or Microsoft Teams call's live captions and your screenshots in Jantar on your Mac.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Namanjain-share/jantar.git",
    "directory": "packages/extension"
  },
  "homepage": "https://github.com/Namanjain-share/jantar/tree/main/packages/extension#readme",
  "bugs": "https://github.com/Namanjain-share/jantar/issues",
  "keywords": ["chrome-extension", "google-meet", "microsoft-teams", "captions", "claude-code"],
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build.mjs --test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.src.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist dist-test"
  },
  "devDependencies": {
    "@jantar/fixtures": "workspace:*",
    "@jantar/protocol": "workspace:*",
    "@types/chrome": "0.3.5",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}

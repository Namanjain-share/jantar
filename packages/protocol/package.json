{
  "name": "@jantar/protocol",
  "version": "0.12.2",
  "private": true,
  "license": "FSL-1.1-MIT",
  "description": "Shared zod schemas, event types, reducer and REST types for Jantar.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Namanjain-share/jantar.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/Namanjain-share/jantar/tree/main/packages/protocol#readme",
  "bugs": "https://github.com/Namanjain-share/jantar/issues",
  "keywords": ["claude-code", "zod", "schemas", "rest-api"],
  "type": "module",
  "exports": {
    ".": {
      "@jantar/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node-link": {
      "@jantar/source": "./src/node-link.ts",
      "types": "./dist/node-link.d.ts",
      "default": "./dist/node-link.js"
    },
    "./post-url": {
      "@jantar/source": "./src/post-url.ts",
      "types": "./dist/post-url.d.ts",
      "default": "./dist/post-url.js"
    },
    "./people-core": {
      "@jantar/source": "./src/people-core.ts",
      "types": "./dist/people-core.d.ts",
      "default": "./dist/people-core.js"
    },
    "./people": {
      "@jantar/source": "./src/people.ts",
      "types": "./dist/people.d.ts",
      "default": "./dist/people.js"
    },
    "./work": {
      "@jantar/source": "./src/work.ts",
      "types": "./dist/work.d.ts",
      "default": "./dist/work.js"
    },
    "./page-read": {
      "@jantar/source": "./src/page-read.ts",
      "types": "./dist/page-read.d.ts",
      "default": "./dist/page-read.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
